# ── Flutterwave ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxx
FLUTTERWAVE_SECRET_HASH=replace-with-your-dashboard-webhook-secret-hash

# ── Admin notification (server-side, via Vercel serverless function) ───────────
# Resend (https://resend.com) — free tier supports 100 emails/day.
# 1. Create an account and verify your sending domain
# 2. Generate an API key
# 3. Add it here AND in Vercel: Project → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxx
ADMIN_EMAIL=info@agbedefoundation.org

# ── Vite / Frontend (baked in at build time) ───────────────────────────────────
# Add these in Vercel: Project → Settings → Environment Variables
# They are also injected during the GitHub Actions build step below.
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx
VITE_DONATION_SUPPORT_EMAIL=info@agbedefoundation.org

# ── Future: WhatsApp Business Cloud API ────────────────────────────────────────
# When ready, add the notify call inside api/flutterwave/verify.ts alongside Resend.
# 1. Set up Meta Business account + WhatsApp Business Cloud API
# 2. Add: WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID
# 3. Recipient: +234 805 737 0966
