# ── Flutterwave ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.flutterwave.com → Settings → API Keys
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxx
FLUTTERWAVE_SECRET_HASH=replace-with-your-dashboard-webhook-secret-hash

# ── Vite / Frontend (baked in at build time) ───────────────────────────────────
# IMPORTANT for GitHub Pages / static deploys:
#   Add these as GitHub Actions secrets in:
#   Repository → Settings → Secrets and variables → Actions → New repository secret
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxx
VITE_DONATION_SUPPORT_EMAIL=info@agbedefoundation.org

# ── Admin email notification (EmailJS — client-side, no server needed) ─────────
# Sign up free at https://www.emailjs.com
# 1. Create an email service (Gmail, Outlook, etc.)
# 2. Create an email template with these variables:
#    {{donor_name}}, {{donor_email}}, {{amount}}, {{currency}},
#    {{donor_message}}, {{tx_ref}}
# 3. Set your recipient email inside the EmailJS template (e.g. info@agbedefoundation.org)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# ── Future: WhatsApp Business Cloud API ────────────────────────────────────────
# When you are ready to add WhatsApp notifications (to +234 805 737 0966):
# 1. Set up a Meta Business account and WhatsApp Business Cloud API
# 2. Move the notify logic to a serverless function (Vercel / Cloudflare Workers)
# 3. Add: WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_RECIPIENT
